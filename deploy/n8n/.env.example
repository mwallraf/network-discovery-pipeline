# Copy to .env and fill in. Keep .env out of git (it holds the encryption key).

# Name people use to reach n8n (must resolve to this server).
N8N_HOST=n8n.example.internal

# Pinned versions. Upgrade deliberately; read the n8n release notes first.
N8N_VERSION=2.42.6
CADDY_VERSION=2.11.7

# Generate once with: openssl rand -hex 32
# KEEP IT: without this key n8n cannot decrypt its stored credentials.
N8N_ENCRYPTION_KEY=

TZ=UTC

# "internal" = Caddy's own certificate authority (browsers must trust its root, see README)
# or "/certs/n8n.crt /certs/n8n.key" with those files in ./certs
CADDY_TLS=internal

# Subnet for the containers; pick one that is not used in your network.
DOCKER_SUBNET=192.168.255.0/24
